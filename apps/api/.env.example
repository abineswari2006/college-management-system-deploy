NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Leave DATABASE_URL empty to use embedded PostgreSQL for local development.
# Production must provide a PostgreSQL connection string.
DATABASE_URL=
PGLITE_DATA_DIR=.pglite
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# Local development generates an ephemeral signing secret if this is omitted.
# Set a unique value with at least 32 random bytes in every deployed environment.
SESSION_SECRET=

# Configure SMTP to deliver password-reset and user-invitation links.
SMTP_URL=
MAIL_FROM=

# Development seed only. Never use these credentials in production.
DEMO_ADMIN_EMAIL=admin@college.test
DEMO_ADMIN_PASSWORD=Admin@12345

# Set only when the API is behind a known trusted reverse proxy.
TRUST_PROXY_HOPS=0